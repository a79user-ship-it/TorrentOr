<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BitFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:buttonStyle">@style/Widget.BitFlow.Button</item>
        <item name="colorPrimary">@color/torrentor_teal</item>
        <item name="colorSecondary">@color/torrentor_orange</item>
        <item name="colorAccent">@color/torrentor_teal</item>
        <item name="android:colorAccent">@color/torrentor_teal</item>
        <item name="colorControlActivated">@color/torrentor_teal</item>
    </style>

    <style name="Theme.BitFlow" parent="Base.Theme.BitFlow" />

    <style name="Widget.BitFlow.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/torrentor_button_background</item>
        <item name="android:textColor">@color/torrentor_teal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
