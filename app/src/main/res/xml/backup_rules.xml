<?xml version="1.0" encoding="utf-8"?><!--
   TorrentOr backup rules.

   Torrent persistence (the saved magnet/file list, deleted markers, paused
   markers, file priorities and dates) is EXCLUDED from cloud backup on
   purpose: when the app is installed on a new device, Android restores the
   old backup and previously deleted torrents would come back. A fresh
   install must start with an empty torrent list.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="torrent_store.xml" />
    <exclude domain="sharedpref" path="deleted_torrents.xml" />
    <exclude domain="sharedpref" path="paused_torrents.xml" />
    <exclude domain="sharedpref" path="file_priorities.xml" />
    <exclude domain="sharedpref" path="torrent_dates.xml" />
    <exclude domain="sharedpref" path="global_stats.xml" />
    <exclude domain="sharedpref" path="rss_feeds.xml" />
</full-backup-content>
