<?xml version="1.0" encoding="utf-8"?><!--
   TorrentOr data extraction rules (Android 12+).

   Same policy as backup_rules.xml: torrent persistence is excluded from both
   cloud backup and device-to-device transfer so deleted torrents can never
   reappear on a new phone.
   See https://developer.android.com/guide/topics/data/autobackup#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="torrent_store.xml" />
        <exclude domain="sharedpref" path="deleted_torrents.xml" />
        <exclude domain="sharedpref" path="paused_torrents.xml" />
        <exclude domain="sharedpref" path="file_priorities.xml" />
        <exclude domain="sharedpref" path="torrent_dates.xml" />
        <exclude domain="sharedpref" path="global_stats.xml" />
        <exclude domain="sharedpref" path="rss_feeds.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="torrent_store.xml" />
        <exclude domain="sharedpref" path="deleted_torrents.xml" />
        <exclude domain="sharedpref" path="paused_torrents.xml" />
        <exclude domain="sharedpref" path="file_priorities.xml" />
        <exclude domain="sharedpref" path="torrent_dates.xml" />
        <exclude domain="sharedpref" path="global_stats.xml" />
        <exclude domain="sharedpref" path="rss_feeds.xml" />
    </device-transfer>
</data-extraction-rules>
